{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "narrative-workshop-agent",
  "main": "index.js",
  "compatibility_date": "2026-09-01",
  "ai": { "binding": "AI" },
  "vars": {
    "TEXT_MODEL": "@cf/zai-org/glm-4.7-flash",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell",
    "MAX_TOKENS": "9000",
    "ALLOWED_ORIGINS": ""
  }
}
